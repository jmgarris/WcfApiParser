<Window
    x:Class="WcfNetTcpClientGenerator.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WcfNetTcpClientGenerator.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WCF Net.TCP Client Generator">
    <ScrollViewer>
        <Grid x:Name="RootLayout" Padding="24" RowSpacing="16" ColumnSpacing="16">
            <Grid.Resources>
                <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="WCF Net.TCP Client Generator" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Analyze metadata, generate a clean .NET 10 client library, and package it as NuGet." Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                    <TextBlock Text="WCF service endpoint URL" />
                    <TextBox Text="{Binding ServiceEndpointUrl, Mode=TwoWay}" PlaceholderText="net.tcp://server:808/MyService" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                    <TextBlock Text="Metadata endpoint URL" />
                    <TextBox Text="{Binding MetadataEndpointUrl, Mode=TwoWay}" PlaceholderText="http://server:808/MyService/mex" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                    <TextBlock Text="WSDL file path" />
                    <TextBox Text="{Binding WsdlFilePath, Mode=TwoWay}" PlaceholderText="C:\Metadata\service.wsdl" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                    <TextBlock Text="Metadata folder path" />
                    <TextBox Text="{Binding MetadataFolderPath, Mode=TwoWay}" PlaceholderText="C:\Metadata\ServiceDefinition" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                    <TextBlock Text="Service namespace" />
                    <TextBox Text="{Binding ServiceNamespace, Mode=TwoWay}" PlaceholderText="Contoso.Services.Customer" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                    <TextBlock Text="Generated class library name" />
                    <TextBox Text="{Binding GeneratedLibraryName, Mode=TwoWay}" PlaceholderText="Contoso.CustomerClient" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                    <TextBlock Text="Generated output type" />
                    <ComboBox ItemsSource="{Binding GeneratedOutputKinds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedGeneratedOutputKind, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="TransportWithMessageCredential requires the .NET Framework 4.8.1 REST API wrapper because the .NET 10 generated client path does not support this WCF net.tcp security mode." TextWrapping="Wrap" Opacity="0.75" />
                <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="Enable Swagger / API documentation" IsChecked="{Binding EnableSwagger, Mode=TwoWay}" Visibility="{Binding IsRestApiWrapperSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel Grid.Row="6" Grid.Column="0" Spacing="6" Visibility="{Binding IsClientLibrarySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="NuGet package ID" />
                    <TextBox Text="{Binding PackageId, Mode=TwoWay}" PlaceholderText="Contoso.CustomerClient" />
                </StackPanel>

                <StackPanel Grid.Row="6" Grid.Column="1" Spacing="6" Visibility="{Binding IsClientLibrarySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="NuGet package version" />
                    <TextBox Text="{Binding PackageVersion, Mode=TwoWay}" PlaceholderText="1.0.0" />
                </StackPanel>

                <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                    <TextBlock Text="dotnet-svcutil path (optional)" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DotNetSvcUtilPath, Mode=TwoWay}" PlaceholderText="C:\Users\you\.dotnet\tools\dotnet-svcutil.exe" />
                        <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseDotNetSvcUtilPathCommand}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                    <TextBlock Text="Output folder" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OutputFolder, Mode=TwoWay}" PlaceholderText="C:\Output\Clients" />
                        <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseOutputFolderCommand}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="9" Grid.Column="0" Spacing="6">
                    <TextBlock Text="Security mode" />
                    <ComboBox ItemsSource="{Binding SecurityModes}" SelectedItem="{Binding SecurityMode, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="9" Grid.Column="1" Spacing="6">
                    <TextBlock Text="TCP transport credential type" />
                    <ComboBox ItemsSource="{Binding TcpCredentialTypes}" SelectedItem="{Binding TcpTransportClientCredentialType, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6" Visibility="{Binding IsMessageCredentialTypeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Message credential type" />
                    <ComboBox ItemsSource="{Binding TcpCredentialTypes}" SelectedItem="{Binding MessageClientCredentialType, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="11" Grid.Column="0" Spacing="6">
                    <TextBlock Text="Reliable session enabled" />
                    <CheckBox IsChecked="{Binding ReliableSessionEnabled, Mode=TwoWay}" Content="Enable reliable sessions when supported" />
                </StackPanel>

                <StackPanel Grid.Row="11" Grid.Column="1" Spacing="6">
                    <TextBlock Text="Max received message size" />
                    <TextBox Text="{Binding MaxReceivedMessageSize, Mode=TwoWay}" />
                </StackPanel>

                <Grid Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Open timeout" />
                        <TextBox Text="{Binding OpenTimeout, Mode=TwoWay}" PlaceholderText="00:00:30" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Send timeout" />
                        <TextBox Text="{Binding SendTimeout, Mode=TwoWay}" PlaceholderText="00:01:40" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="Receive timeout" />
                        <TextBox Text="{Binding ReceiveTimeout, Mode=TwoWay}" PlaceholderText="00:01:40" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Username" />
                        <TextBox Text="{Binding Username, Mode=TwoWay}" PlaceholderText="Optional" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Password" />
                        <PasswordBox PasswordChanged="PasswordBox_OnPasswordChanged" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" Spacing="8" Visibility="{Binding IsCertificateConfigurationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Client certificate" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox Header="Certificate source" ItemsSource="{Binding CertificateSources}" SelectedItem="{Binding ClientCertificateSource, Mode=TwoWay}" />
                    <Grid ColumnSpacing="12" Visibility="{Binding IsCertificateStoreSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox Header="Store location" ItemsSource="{Binding CertificateStoreLocations}" SelectedItem="{Binding ClientCertificateStoreLocation, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1" Header="Store name" ItemsSource="{Binding CertificateStoreNames}" SelectedItem="{Binding ClientCertificateStoreName, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2" Header="Find type" ItemsSource="{Binding CertificateFindTypes}" SelectedItem="{Binding ClientCertificateFindType, Mode=TwoWay}" />
                    </Grid>
                    <TextBox Header="Certificate find value" Text="{Binding ClientCertificateFindValue, Mode=TwoWay}" Visibility="{Binding IsCertificateStoreSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Spacing="6" Visibility="{Binding IsCertificateFileSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox Header="Certificate file path (.pfx or .p12)" Text="{Binding ClientCertificateFilePath, Mode=TwoWay}" />
                        <ComboBox Header="Certificate password source" ItemsSource="{Binding CertificatePasswordSources}" SelectedItem="{Binding ClientCertificateFilePasswordSource, Mode=TwoWay}" />
                        <TextBox Header="Password environment variable name" Text="{Binding ClientCertificateFilePasswordEnvironmentVariableName, Mode=TwoWay}" />
                        <TextBox Header="Password app setting name" Text="{Binding ClientCertificateFilePasswordAppSettingName, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Text="Prefer a certificate thumbprint. Do not place certificate passwords in source control or plain Web.config." TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>

                <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                    <TextBlock Text="AI Documentation" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Generate XML documentation comments with a selectable provider or stay on deterministic local fallback comments." TextWrapping="Wrap" Opacity="0.75" />
                    <TextBlock Text="The generated client library never includes AI provider packages, keys, or settings." TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>

                <Grid Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Documentation provider" />
                        <ComboBox
                            ItemsSource="{Binding DocumentationProviders}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding SelectedDocumentationProvider, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Text="Local fallback works without AI access. Microsoft 365 Copilot may require tenant consent. OpenAI prefers the OPENAI_API_KEY environment variable by default." TextWrapping="Wrap" Opacity="0.75" />
                </Grid>

                <StackPanel
                    Grid.Row="16"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Spacing="10"
                    Visibility="{Binding IsCopilotProviderSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="Enable Microsoft 365 Copilot comments" IsChecked="{Binding EnableCopilotComments, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding CopilotStatusText}" TextWrapping="Wrap" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Tenant ID" />
                            <TextBox Text="{Binding CopilotTenantId, Mode=TwoWay}" PlaceholderText="organizations or tenant GUID" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Client ID" />
                            <TextBox Text="{Binding CopilotClientId, Mode=TwoWay}" PlaceholderText="Microsoft Entra app registration client ID" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Required scopes" />
                        <TextBox Text="{Binding CopilotRequiredScopes, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Sign in" Command="{Binding SignInToCopilotCommand}" />
                        <Button Grid.Column="1" Content="Sign out" Command="{Binding SignOutOfCopilotCommand}" />
                        <Button Grid.Column="2" Content="Test Copilot connection" Command="{Binding TestCopilotConnectionCommand}" />
                        <Button Grid.Column="3" Content="Regenerate comments" Command="{Binding RegenerateCommentsCommand}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding SignedInAccount}" TextWrapping="Wrap" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Max comment length" />
                            <TextBox Text="{Binding CopilotMaxCommentLength, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Timeout (seconds)" />
                            <TextBox Text="{Binding CopilotTimeoutSeconds, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Retry count" />
                            <TextBox Text="{Binding CopilotRetryCount, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Use interactive sign-in" IsChecked="{Binding CopilotUseInteractiveSignIn, Mode=TwoWay}" />
                        <CheckBox Grid.Column="1" Content="Cache generated comments" IsChecked="{Binding CacheGeneratedComments, Mode=TwoWay}" />
                        <CheckBox Grid.Column="2" Content="Disable web grounding if supported" IsChecked="{Binding CopilotDisableWebGrounding, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <StackPanel
                    Grid.Row="17"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Spacing="10"
                    Visibility="{Binding IsOpenAiProviderSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="Enable OpenAI comments" IsChecked="{Binding EnableOpenAiComments, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding OpenAiStatusText}" TextWrapping="Wrap" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="API key source" />
                            <ComboBox
                                ItemsSource="{Binding OpenAiApiKeySources}"
                                DisplayMemberPath="Label"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding SelectedOpenAiApiKeySource, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="API key environment variable name" />
                            <TextBox Text="{Binding OpenAiApiKeyEnvironmentVariableName, Mode=TwoWay}" PlaceholderText="OPENAI_API_KEY" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6" Visibility="{Binding IsUserEnteredOpenAiKeySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="API key" />
                        <PasswordBox PasswordChanged="OpenAiApiKeyPasswordBox_OnPasswordChanged" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Model name" />
                            <TextBox Text="{Binding OpenAiModelName, Mode=TwoWay}" PlaceholderText="gpt-5.6-luna" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Max output tokens" />
                            <TextBox Text="{Binding OpenAiMaxOutputTokens, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Reasoning effort" />
                            <ComboBox ItemsSource="{Binding OpenAiReasoningEfforts}" SelectedItem="{Binding OpenAiReasoningEffort, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="6">
                            <TextBlock Text="Temperature (legacy models only)" />
                            <TextBox Text="{Binding OpenAiTemperature, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Timeout (seconds)" />
                            <TextBox Text="{Binding OpenAiTimeoutSeconds, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Retry count" />
                            <TextBox Text="{Binding OpenAiRetryCount, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Max comment length" />
                            <TextBox Text="{Binding CopilotMaxCommentLength, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Test OpenAI connection" Command="{Binding TestOpenAiConnectionCommand}" />
                        <Button Grid.Column="1" Content="Clear OpenAI cached comments" Command="{Binding ClearOpenAiCachedCommentsCommand}" />
                        <Button Grid.Column="2" Content="Regenerate OpenAI comments" Command="{Binding RegenerateCommentsCommand}" />
                        <CheckBox Grid.Column="3" VerticalAlignment="Center" Content="Cache generated comments" IsChecked="{Binding CacheGeneratedComments, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                <Button Content="Test dotnet-svcutil" Command="{Binding TestDotNetSvcUtilCommand}" />
                <Button Content="Analyze Service Metadata" Command="{Binding AnalyzeServiceMetadataCommand}" />
                <Button Content="{Binding GenerateOutputButtonText}" Command="{Binding GenerateClassLibraryCommand}" />
                <Button Content="Package Class Library as NuGet" Command="{Binding PackageClassLibraryCommand}" Visibility="{Binding IsClientLibrarySelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding BusyMessage}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="8">
                <TextBlock Text="Detected service operations" FontSize="20" FontWeight="SemiBold" />
                <ListView ItemsSource="{Binding Operations}" MinHeight="220">
                    <ListView.Header>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Contract" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Operation" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Signature" FontWeight="SemiBold" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ContractName}" />
                                <TextBlock Grid.Column="1" Text="{Binding OperationName}" />
                                <TextBlock Grid.Column="2" Text="{Binding Signature}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Status and progress" FontSize="20" FontWeight="SemiBold" />
                    <Button
                        Grid.Column="1"
                        Content="Clear Status"
                        Command="{Binding ClearStatusCommand}"
                        automation:AutomationProperties.Name="Clear status history"
                        ToolTipService.ToolTip="Clear the displayed status and progress messages." />
                </Grid>
                <ListView ItemsSource="{Binding StatusMessages}" MinHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
